# Copy to .env for local API development (cargo run).
BIND_ADDR=0.0.0.0:8080
DATABASE_URL=postgres://authority:authority@localhost:5432/authority
REDIS_URL=redis://localhost:6379
RATE_LIMIT_PER_MINUTE=120
CORS_ALLOW_ORIGIN=*
STRICT_READINESS=false
RUST_LOG=info,tower_http=debug,public_authority_api=debug
